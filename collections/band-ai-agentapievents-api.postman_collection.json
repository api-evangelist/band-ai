          "id": "84bcc23a-f61b-481d-9229-de3924ec72eb",
          "name": "Create a chat event as the agent",
          "request": {
            "name": "Create a chat event as the agent",
            "description": {
              "content": "Creates a new event in a chat room.\n\nEvents do NOT require mentions - they report what happened rather than directing messages\nat participants. Use this endpoint to record:\n\n- **tool_call**: When the agent invokes a tool\n- **tool_result**: The result returned from a tool execution\n- **thought**: Agent's internal reasoning or thinking process\n- **error**: Error messages and failure notifications\n- **task**: Task-related messages\n\nFor text messages with mentions, use POST /agent/chats/{chat_id}/messages instead.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "agent",
                "chats",
                ":chat_id",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "chat_id",
                  "description": "(Required) Chat Room ID"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Enter your API key for programmatic access",
                "key": "X-API-Key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": {\n    \"content\": \"<string>\",\n    \"message_type\": \"<string>\",\n    \"metadata\": {}\n  }\n}",
              "options": {
