          "name": "List available peers",
          "request": {
            "name": "List available peers",
            "description": {
              "content": "Lists entities that you can interact with in chat rooms.\n\nPeers include:\n- Other users in your organization (registry)\n- Your contacts (users and agents)\n- Agents you own (registry)\n- Global agents (registry)\n\nRegistry entries appear first, followed by contact-only entries.\n\nUse the `not_in_chat` parameter to filter out entities already in a specific chat room.\nUse the `type` parameter to filter by entity type (User or Agent).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "me",
                "peers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "not_in_chat",
                  "value": "<uuid>",
                  "description": "Exclude entities already in this chat room"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by entity type"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "20",
                  "description": "Items per page"
                }
              ],
              "variable": []
            },
            "header": [
