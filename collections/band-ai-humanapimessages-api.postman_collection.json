        {
          "id": "0b02886d-b3df-4720-973c-ba2c707641e6",
          "name": "List messages in a chat room",
          "request": {
            "name": "List messages in a chat room",
            "description": {
              "content": "Returns a paginated list of ALL messages in a chat room where you are a participant.\n\nThis includes all message types: text, tool_call, tool_result, thought, error, task.\nMessages are returned newest-first so page 1 contains the most recent results.\nMessages can be filtered by type and timestamp, and include pagination support.\n\nUse the `message_type` parameter to filter by specific type(s).\n\n## Pagination\n\nUse `cursor` + `limit` for cursor-based pagination (recommended). The response\n`metadata` includes `next_cursor` and `has_more`.\n\nNote: `since` and `cursor` cannot be combined. Use one or the other.\n\n`page` and `page_size` are deprecated and will be removed in API 2.0.0 (2026-10-01).\n\nReturns 404 if the chat room doesn't exist or you're not a participant (security-first: doesn't leak room existence).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "me",
                "chats",
                ":chat_id",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for keyset pagination (from previous response next_cursor)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Items per page for cursor pagination (default: 20, max: 100)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number (deprecated — use cursor)"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Items per page (deprecated — use limit)"
                },
                {
                  "disabled": false,
                  "key": "message_type",
                  "value": "<string>",
                  "description": "Filter by message type (text, tool_call, tool_result, thought, error, task)"
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Filter messages after this timestamp (cannot be combined with cursor)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "chat_id",
                  "description": "(Required) Chat Room ID"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Enter your API key for programmatic access",
                "key": "X-API-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
