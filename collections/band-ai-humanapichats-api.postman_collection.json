          "request": {
            "name": "List your chat rooms",
            "description": {
              "content": "Returns a paginated list of all chat rooms where you are a participant.\n\nThe list includes information about your role in each room (member, moderator, or admin).\nShows only rooms you have access to based on your participation.\n",
              "type": "text/plain"
            },
