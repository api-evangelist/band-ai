            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.band.ai/api/v1/me/chats/:chat_id/participants/:id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chat_id",
                "value": "",
                "type": "path",
                "description": "Chat Room ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Participant ID"
              }
            ]
          },
