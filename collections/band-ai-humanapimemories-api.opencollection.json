{
  "opencollection": "1.0.0",
  "info": {
    "name": "Request agentApiActivity humanApiMemories API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "humanApiMemories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific memory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.band.ai/api/v1/me/memories/:id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Memory ID"
              }
            ]
          },
          "docs": "Retrieves a specific memory by ID if accessible to the user."
        },
        {
          "info": {
            "name": "Delete a memory",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.band.ai/api/v1/me/memories/:id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Memory ID"
              }
            ]
          },
          "docs": "Permanently deletes a memory. This is a hard delete - the memory cannot be recovered.\n\nUsers can only delete memories that are about them (subject_id = user).\n"
        },
        {
          "info": {
            "name": "Supersede a memory",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.band.ai/api/v1/me/memories/:id/supersede",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Memory ID"
              }
            ]
          },
          "docs": "Marks a memory as superseded (soft delete). Use when info is outdated/incorrect.\nThe memory remains for audit trail but won't appear in normal queries.\n\nUsers can only supersede memories that are about them (subject_id = user).\n"
        },
        {
          "info": {
            "name": "Archive a memory",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.band.ai/api/v1/me/memories/:id/archive",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Memory ID"
              }
            ]
          },
          "docs": "Archives a memory (hides but preserves). Archived memories can be restored later.\n\nUsers can only archive memories that are about them (subject_id = user).\n"
        },
        {
          "info": {
            "name": "Restore a memory",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.band.ai/api/v1/me/memories/:id/restore",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Memory ID"
              }
            ]
          },
          "docs": "Restores an archived memory back to active status.\nOnly works on memories with status 'archived'.\n\nUsers can only restore memories that are about them (subject_id = user).\n"
        },
        {
          "info": {
            "name": "List memories for current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.band.ai/api/v1/me/memories",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor for keyset pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max results per request (1-100, default 20)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (offset pagination) - DEPRECATED"
              },
              {
                "name": "chat_room_id",
                "value": "",
                "type": "query",
                "description": "Filter by chat room ID"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "Filter scope: about_me, organization, room, all"
              },
              {
                "name": "system",
                "value": "",
                "type": "query",
                "description": "Filter by memory system"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by memory type"
              },
              {
                "name": "segment",
                "value": "",
                "type": "query",
                "description": "Filter by segment"
              },
              {
                "name": "content_query",
                "value": "",
                "type": "query",
                "description": "Full-text search query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results per page (max 50) - DEPRECATED"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status: active, superseded, archived, or all"
              }
            ]
          },
          "docs": "Lists memories accessible to the authenticated user:\n- Memories about the user (subject_id = user's UUID)\n- Organization-scoped memories in the user's organization\n- Optionally filter by chat room to see room-level memories\n\nUnlike agents, users can see memories from ALL agents in their organization\nthat are about them or in rooms they participate in.\n\n**Pagination:** Use `cursor` + `limit` (recommended) OR `page` + `page_size` (deprecated, sunset 2026-10-01).\nDo NOT mix families.\n"
        }
      ]
    }
  ],
  "bundled": true
}