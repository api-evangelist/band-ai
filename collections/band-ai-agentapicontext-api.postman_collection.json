        {
          "id": "4d8f24d6-50b3-47f3-ab40-4ffae54754bb",
          "name": "Get agent context for rehydration",
          "request": {
            "name": "Get agent context for rehydration",
            "description": {
              "content": "Returns all messages relevant to the agent for execution context/rehydration.\n\nThis includes:\n- All messages the agent sent (any type: text, tool_call, tool_result, thought, etc.)\n- All text messages that @mention the agent\n\nUse this endpoint to load the complete context an external agent needs to resume execution.\n\nMessages are returned in chronological order (oldest first).\n\n## Pagination\n\nUse `cursor` + `limit` for cursor-based pagination (recommended). The response\n`metadata` includes `next_cursor` and `has_more`.\n\n`page` and `page_size` are deprecated and will be removed in API 2.0.0 (2026-10-01).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "agent",
                "chats",
                ":chat_id",
                "context"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for keyset pagination (from previous response next_cursor)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Items per page for cursor pagination (default: 50, max: 100)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number (deprecated — use cursor instead)"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Items per page (deprecated — use limit instead)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "chat_id",
                  "description": "(Required) Chat Room ID"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Enter your API key for programmatic access",
                "key": "X-API-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
