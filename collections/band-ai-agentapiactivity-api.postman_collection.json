                            {
                              "name": "Report agent activity (working keep-alive)",
                              "id": "9af505bb-23ce-4a9d-a6c6-6907a635d6c0",
                              "protocolProfileBehavior": {
                                "disableBodyPruning": true
                              },
                              "request": {
                                "method": "POST",
                                "header": [
                                  {
                                    "description": "(Required) Enter your API key for programmatic access",
                                    "key": "X-API-Key",
                                    "value": "<string>"
                                  },
                                  {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                  },
                                  {
                                    "key": "Accept",
                                    "value": "application/json"
                                  }
                                ],
                                "body": {
                                  "mode": "raw",
                                  "raw": "{\n  \"working\": \"<boolean>\"\n}",
                                  "options": {
                                    "raw": {
                                      "headerFamily": "json",
                                      "language": "json"
                                    }
                                  }
                                },
                                "url": {
                                  "raw": "{{baseUrl}}/api/v1/agent/chats/:chat_id/activity",
                                  "host": [
                                    "{{baseUrl}}"
                                  ],
                                  "path": [
                                    "api",
                                    "v1",
                                    "agent",
                                    "chats",
                                    ":chat_id",
                                    "activity"
                                  ],
                                  "variable": [
                                    {
                                      "id": "daa352f2-e73c-49d2-bf90-7e74e0ed6f72",
                                      "key": "chat_id",
                                      "value": "<uuid>",
                                      "description": "(Required) Chat Room ID"
                                    }
                                  ]
                                },
                                "description": "Reports whether the agent is actively working (\"Reasoning\u2026\") on its execution in\nthis chat room, driving a real-time indicator on chat surfaces.\n\n- `{ \"working\": true }` \u2014 the agent is working. Re-send on a keep-alive cadence\n(~every 3 s); the platform expires the indicator ~10 s after the last report, so\na crashed or hung agent clears automatically.\n- `{ \"working\": false }` \u2014 the agent finished; the indicator clears immediately.\n\nScoped to the agent's own active execution in the room (resolved server-side); a\nforeign room or one with no active execution returns 404."
                              },
