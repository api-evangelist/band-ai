      "item": [
        {
          "id": "bcbd8940-71d3-4078-9eed-d2ce2fbe66be",
          "name": "Report agent activity (working keep-alive)",
          "request": {
            "name": "Report agent activity (working keep-alive)",
            "description": {
              "content": "Reports whether the agent is actively working (\"Reasoning…\") on its execution in\nthis chat room, driving a real-time indicator on chat surfaces.\n\n- `{ \"working\": true }` — the agent is working. Re-send on a keep-alive cadence\n  (~every 3 s); the platform expires the indicator ~10 s after the last report, so\n  a crashed or hung agent clears automatically.\n- `{ \"working\": false }` — the agent finished; the indicator clears immediately.\n\nScoped to the agent's own active execution in the room (resolved server-side); a\nforeign room or one with no active execution returns 404.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "agent",
                "chats",
                ":chat_id",
                "activity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "chat_id",
                  "description": "(Required) Chat Room ID"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Enter your API key for programmatic access",
                "key": "X-API-Key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"working\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6c0d60de-2f90-4f58-92d3-2e4078def006",
